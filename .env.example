NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable moderna (recomendada). NEXT_PUBLIC_SUPABASE_ANON_KEY sigue soportada.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usa SUPABASE_SECRET_KEY en proyectos nuevos o la service_role heredada.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña compartida del panel. Usa una frase larga y única.
APP_PASSWORD=

# Secreto largo compartido exclusivamente entre el plugin Paper y estos endpoints.
# No uses el prefijo NEXT_PUBLIC_ y no lo incluyas en config.yml dentro de Git.
MINECRAFT_WEBHOOK_SECRET=
